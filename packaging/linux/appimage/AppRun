#!/bin/sh
# AppRun of the Uzume AppImage (build-appimage.sh passes it to linuxdeploy as the custom AppRun).
HERE="$(dirname "$(readlink -f "$0")")"
APPDIR="${APPDIR:-$HERE}"
export APPDIR

# The program directory inside the image is not a place for user data: the AppImage mount is read-only, but the
# extract-and-run mode (no FUSE) unpacks into a writable temporary folder, where the app would otherwise pick its
# portable "data" folder and lose everything on exit. Pin the data folder to the XDG data location (the same folder
# the app uses when its program directory is read-only). A value set by the user wins.
if [ -z "${UZUME_DATA_DIR:-}" ]; then
  UZUME_DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/Uzume/Uzume"
  export UZUME_DATA_DIR
fi

# Qt 6.4 on Ubuntu 24.04: the image carries the FFmpeg media backend only (no GStreamer).
export QT_MEDIA_BACKEND="${QT_MEDIA_BACKEND:-ffmpeg}"

# libOpenGL.so.0 (glvnd) is a system library the image does not carry. Without it the loader aborts with a message
# nobody sees when the app is started from a file manager (#339): say it, with the package name, and stop.
if ! { ldconfig -p 2>/dev/null || /sbin/ldconfig -p 2>/dev/null; } | grep -q 'libOpenGL\.so\.0'; then
  found=""
  # The loader also searches LD_LIBRARY_PATH (a library from a nonstandard location), so look there first.
  old_ifs="$IFS"; IFS=:
  for d in ${LD_LIBRARY_PATH:-} /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu /usr/lib64 /usr/lib /lib/x86_64-linux-gnu /lib/aarch64-linux-gnu /lib64 /lib; do
    if [ -n "$d" ] && [ -e "$d/libOpenGL.so.0" ]; then found=1; break; fi
  done
  IFS="$old_ifs"
  if [ -z "$found" ]; then
    msg="Uzume needs the system library libOpenGL.so.0, which is not installed. Install the package libopengl0 (Debian, Ubuntu) or libglvnd-opengl (Fedora), then start Uzume again."
    echo "$msg" >&2
    if command -v notify-send >/dev/null 2>&1; then notify-send -u critical "Uzume cannot start" "$msg" >/dev/null 2>&1 || true; fi
    exit 1
  fi
fi

exec "$APPDIR/usr/bin/uzume" "$@"
